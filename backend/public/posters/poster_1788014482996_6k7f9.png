<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="1350" viewBox="0 0 1080 1350">
    <foreignObject width="1080" height="1350">
      <!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    width: 1080px;
    height: 1350px;
    background: #020617;
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
  }
  .bg-image {
    position: absolute;
    top: 0; left: 0; width: 1080px; height: 1350px;
    object-fit: cover;
    filter: contrast(1.1) brightness(0.85);
  }
  .sold-ribbon {
    position: absolute;
    top: 80px; right: -80px;
    width: 450px;
    background: linear-gradient(135deg, #DC2626 0%, #991B1B 100%);
    color: #FFFFFF;
    font-size: 36px;
    font-weight: 900;
    text-align: center;
    padding: 16px 0;
    transform: rotate(45deg);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    letter-spacing: 4px;
    z-index: 20;
  }
  .header-bar {
    position: absolute;
    top: 50px; left: 60px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(20px);
    padding: 16px 32px;
    border-radius: 20px;
    font-size: 26px;
    font-weight: 800;
    border: 1px solid rgba(255,255,255,0.2);
  }
  .bottom-card {
    position: absolute;
    bottom: 50px; left: 50px; right: 50px;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(30px);
    border-radius: 32px;
    padding: 44px;
    border: 2px solid #DC2626;
    box-shadow: 0 20px 60px rgba(220,38,38,0.3);
  }
  .title { font-size: 46px; font-weight: 800; margin-bottom: 12px; }
  .sub { font-size: 24px; color: #94A3B8; margin-bottom: 24px; }
  .price { font-size: 52px; font-weight: 900; color: #34D399; margin-bottom: 20px; }
  .footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 20px; }
</style>
</head>
<body>
  <img class="bg-image" src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1200&auto=format&fit=crop" />
  <div class="sold-ribbon">JUST SOLD!</div>
  <div class="header-bar">RealtyPulse Real Estate Agency</div>
  <div class="bottom-card">
    <div class="title">Oceanfront Luxury Suite</div>
    <div class="sub">Marine Drive, Kochi · 3 BHK Apartment</div>
    <div class="price">Closed at ₹2.10 Crore</div>
    <div class="footer">
      <div style="font-size: 22px; font-weight: 700;">Representative: Adwayth VS</div>
      <div style="font-size: 24px; font-weight: 800; color: #60A5FA;">📞 +91 9633541720</div>
    </div>
  </div>
</body>
</html>
    </foreignObject>
  </svg>