# ===================================================================
# Copy this file to .env and fill in real credentials as each API is
# handed over by the integration team. Nothing here is invented —
# every integration file in /integrations reads these exact names
# and fails safely with a clear message until they're set.
# ===================================================================

PORT=5001
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=https://your-public-tunnel.trycloudflare.com

# --- Vapi.ai Integration (Voice Telephony + STT + TTS Engine) --------
# Values generated in Vapi Dashboard (vapi.ai)
VAPI_PRIVATE_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# --- Exotel Telephony (Outbound Call Triggers) ---------------------
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_EXOPHONE_NUMBER=

# --- WhatsApp Business (automation + reminders) ---------------------
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_BUSINESS_NUMBER_ID=
CRM_WHATSAPP_NUMBER=

# --- Telegram Integration (teleproto) --------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- n8n Workflow Integration (Gemini 2.5 Flash + RAG Brain) --------
N8N_AI_WEBHOOK_URL=http://localhost:5678/webhook/realestate-ai

# --- Google Gemini API (LLM Fallback) -------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Database --------------------------------------------------------
DATABASE_URL=
